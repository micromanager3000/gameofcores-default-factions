+/// Asks for power when the grid runs short and no plant is going up to cover it: up to 4 MW for three minutes, at 0.15 ◆
+/// a MW a second, from the neighbour whose plants make the most. A seller weighs it like any deal (`common::fair`), and
+/// gives only power it has spare.
+fn buy(orders: &mut Value, world: View, me: View) {
+    let e = me.get("energy");
+    let (demand, powered) = (e.get("demand").num_or(0.0), e.get("powered").num_or(1.0));
+    if powered >= 0.9 || demand < 2.0 || e.path("deals").iter().any(|x| !x.get("give").truthy()) { return; }
+    let id = me.get("id").num();
+    let sites = me.path("rts.structures");
+    if sites.iter().any(|s| same(s.get("owner"), me.get("id")) && s.get("state").str() == "building" && s.get("power").truthy()) { return; }
+    let mw = (demand * (1.0 - powered)).ceil().clamp(1.0, 4.0);
+    let rate = (mw * 0.15 * 100.0).round() / 100.0;
+    if me.get("bank").num_or(0.0) < rate * 180.0 { return; }
+    let mut made: Vec<(f64, f64)> = neighbours(world, me).into_iter().map(|f| (f, 0.0)).collect();
+    for s in sites.iter().filter(|s| s.get("owner").num_or(id) != id) {
+        if let Some(m) = made.iter_mut().find(|m| m.0 == s.get("owner").num_or(-1.0)) { m.1 += s.path("power.mw").num_or(0.0).max(0.0); }
+    }
+    let Some(&(seller, mw_made)) = made.iter().max_by(|a, b| a.1.total_cmp(&b.1)) else { return };
+    if mw_made < mw + 1.0 { return; }
+    let give = obj! { "coinPerSecond" => rate, "seconds" => 180 };
+    let ask = obj! { "power" => obj! { "mw" => mw, "seconds" => 180 } };
+    diplomacy::send(orders, seller, "power wanted", obj! { "give" => give, "ask" => ask });
+}
