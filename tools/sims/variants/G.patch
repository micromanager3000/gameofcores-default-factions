index 104e382..e7273ea 100644
--- a/shared/common.rs
+++ b/shared/common.rs
@@ -858,6 +858,15 @@ use super::{air, theme};
         plan
     }
 
+    /// Rated MW of your plants standing in province `p` (batteries left out).
+    pub fn grid_mw(me: View, p: f64) -> f64 {
+        let id = me.get("id").num_or(-1.0);
+        me.path("rts.structures").iter()
+            .filter(|s| s.get("owner").num_or(-2.0) == id && s.get("p").num_or(-1.0) == p && s.get("state").str() != "ruin")
+            .map(|s| s.path("power.ports").iter().filter(|q| q.get("kind").str() != "battery").map(|q| q.get("capacity").num_or(0.0)).sum::<f64>())
+            .sum()
+    }
+
     /// The most units a plan names to guard a province ([`defense`]): a bigger threat calls everyone.
     pub const GUARD_MAX: f64 = 24.0;
 
@@ -875,9 +884,11 @@ use super::{air, theme};
         if inv.at < 0.0 {
             return;
         }
-        let want = inv.n * 2.0 + 1.0;
+        // a province with plants of yours gets three for each invader and two more, and everyone once they hold 4 MW
+        let grid = grid_mw(me, inv.at);
+        let want = if grid > 0.0 { inv.n * 3.0 + 2.0 } else { inv.n * 2.0 + 1.0 };
         // (the count of units free to fight comes from me.units, so a big threat costs no pass over world.units)
-        if inv.at == me.get("capital").num() || want > GUARD_MAX || want >= fighters(me) * 0.6 {
+        if inv.at == me.get("capital").num() || grid >= 4.0 || want > GUARD_MAX || want >= fighters(me) * 0.6 {
             plan.set("defend", inv.at);
             return;
         }
